{
  "$comment": "简单配置示例。复制到 workspace/config.json 后修改 API Key 和插件密钥",
  "remoteModel": { "enabled": true },
  "localModel": { "enabled": false, "modelId": "qwen3.5-4b-q4", "contextSize": 32768 },
  "apiUrl": "https://api.deepseek.com",
  "apiKey": "YOUR_API_KEY",
  "model": "deepseek-v4-pro",
  "modelProvider": "openai-chat",
  "maxTokens": 16384,
  "emptyResponseRetries": 1,
  "historyWindowSize": 10,
  "maxContextTokens": 128000,
  "debug": {
    "enabled": true,
    "modelIO": true,
    "rawStreamEvents": true
  },
  "sessionSummary": {
    "enabled": true,
    "turnThreshold": 5,
    "recentTurns": 3,
    "maxInputChars": 40000,
    "maxChars": 10000,
    "maxOutputTokens": 10000
  },
  "autoMemory": {
    "enabled": true,
    "mode": "hybrid",
    "turnThreshold": 10,
    "maxCandidates": 5,
    "maxBatchChars": 8000,
    "lockTimeoutSeconds": 300
  },
  "profile": {
    "enabled": true,
    "maxItemChars": 2000,
    "maxTotalChars": 8000
  },
  "memory": {
    "enabled": true,
    "embedding": {
      "provider": "local-hash",
      "model": "local-hash-v1",
      "dimensions": 384
    }
  },
  "attachments": {
    "enabled": true,
    "maxFilesPerMessage": 4,
    "maxFileSize": 10485760,
    "allowedImageTypes": ["image/png", "image/jpeg", "image/webp", "image/gif"]
  },
  "enabledPlugins": [
    "feishu"
  ],
  "plugins": {
    "feishu": {
      "appId": "cli_xxx",
      "appSecret": "YOUR_FEISHU_APP_SECRET",
      "verificationToken": "YOUR_FEISHU_VERIFICATION_TOKEN"
    }
  },
  "searchProvider": "ollama",
  "ollamaApiKey": "YOUR_OLLAMA_API_KEY",
  "security": {
    "mode": "auto",
    "tools": {}
  }
}
