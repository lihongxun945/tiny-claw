{
  "$comment": "简单配置示例。复制到 workspace/config.json 后修改 API Key 和插件密钥。models 数组是模型配置的唯一权威，defaultModelId 指定默认模型。",
  "models": [
    {
      "id": "remote",
      "name": "远程模型",
      "provider": "openai-chat",
      "model": "deepseek-v4-pro",
      "apiUrl": "https://api.deepseek.com",
      "apiKey": "YOUR_API_KEY"
    }
  ],
  "defaultModelId": "remote",
  "maxTokens": 16384,
  "emptyResponseRetries": 1,
  "maxContextTokens": 128000,
  "bashMaxOutputChars": 10000,
  "fileReadMaxChars": 20000,
  "debug": {
    "enabled": false,
    "modelIO": false,
    "rawStreamEvents": false
  },
  "sessionSummary": {
    "enabled": true,
    "maxInputChars": 40000,
    "maxOutputTokens": 10000,
    "maxOperations": 32,
    "maxItemChars": 1000,
    "maxSourcesPerOperation": 8,
    "checkpointDeltaThreshold": 20,
    "checkpointMaxChars": 50000,
    "recentBatchCount": 5,
    "maxBatchesPerCompression": 3,
    "maxCompressionDurationMs": 120000,
    "maxBatchTokens": 1500,
    "maxBudgetRatio": 0.1,
    "recallMaxResults": 20,
    "recallMaxOutputChars": 20000,
    "recallMaxQueryChars": 500
  },
  "autoMemory": {
    "enabled": true,
    "mode": "hybrid",
    "turnThreshold": 10,
    "maxCandidates": 5,
    "maxBatchChars": 8000,
    "lockTimeoutSeconds": 300
  },
  "profile": {
    "enabled": true,
    "maxItemChars": 2000,
    "maxTotalChars": 8000
  },
  "memory": {
    "enabled": true,
    "embedding": {
      "provider": "local-hash",
      "model": "local-hash-v1",
      "dimensions": 384
    }
  },
  "attachments": {
    "enabled": true,
    "maxFilesPerMessage": 4,
    "maxFileSize": 10485760,
    "allowedImageTypes": ["image/png", "image/jpeg", "image/webp", "image/gif"]
  },
  "enabledPlugins": [
    "feishu"
  ],
  "pluginStates": {
    "feishu": { "enabled": true }
  },
  "plugins": {
    "core-tool-context": { "maxResultTokens": 8000, "readMaxTokens": 4000 },
    "core-user-input": { "enabled": true },
    "feishu": {
      "appId": "cli_xxx",
      "appSecret": "YOUR_FEISHU_APP_SECRET",
      "verificationToken": "YOUR_FEISHU_VERIFICATION_TOKEN"
    }
  },
  "searchProvider": "duckduckgo",
  "ollamaApiKey": "YOUR_OLLAMA_API_KEY",
  "security": {
    "trustedProjects": [],
    "mode": "auto",
    "approvalTtlMs": 86400000,
    "tools": {}
  }
}
