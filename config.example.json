{
  "$comment": "复制到 workspace/config.json 后修改",
  "apiUrl": "https://ark.cn-beijing.volces.com/api/coding",
  "apiKey": "YOUR_API_KEY",
  "model": "deepseek-v4-flash",
  "maxTokens": 4096,
  "maxContextTokens": 128000,
  "contextCompressionThreshold": 0.7,
  "historyWindowSize": 20,
  "maxAgentIterations": 0,
  "searchProvider": "duckduckgo",
  "searxngUrl": "http://localhost:8080",
  "braveApiKey": "YOUR_BRAVE_API_KEY",
  "subAgent": {
    "allowedTools": ["web_search", "web_fetch", "file_read", "memory_list", "skill_list", "skill_use"],
    "disabledTools": ["bash", "file_write", "file_edit", "memory_save", "memory_append", "sub_agent_run"],
    "maxIterations": 3,
    "maxConcurrency": 3
  },
  "enabledPlugins": ["feishu"],
  "externalPlugins": [],
  "plugins": {
    "feishu": {
      "appId": "cli_xxx",
      "appSecret": "YOUR_FEISHU_APP_SECRET",
      "verificationToken": "YOUR_FEISHU_VERIFICATION_TOKEN"
    }
  }
}
