{
  "$comment": "完整配置示例。复制到 workspace/config.json 后按需修改；入门推荐使用 config.simple.example.json",
  "remoteModel": { "enabled": true },
  "localModel": {
    "enabled": false,
    "modelId": "qwen3.5-4b-q4",
    "contextSize": 32768
  },
  "apiUrl": "https://ark.cn-beijing.volces.com/api/coding",
  "apiKey": "YOUR_API_KEY",
  "model": "deepseek-v4-flash",
  "modelProvider": "anthropic-messages",
  "maxTokens": 16384,
  "maxContextTokens": 128000,
  "contextCompressionThreshold": 0.7,
  "contextCompressionMaxChars": 5000,
  "contextCompressionToolResultMaxChars": 500,
  "toolResultInitialMaxChars": 12000,
  "historyWindowSize": 20,
  "maxAgentIterations": 20,
  "sessionSummary": {
    "enabled": true,
    "persistent": true,
    "turnThreshold": 5,
    "recentTurns": 3,
    "maxInputChars": 40000,
    "maxChars": 10000,
    "maxOutputTokens": 10000
  },
  "autoMemory": {
    "enabled": true,
    "mode": "hybrid",
    "turnThreshold": 10,
    "maxCandidates": 5,
    "maxBatchChars": 8000,
    "lockTimeoutSeconds": 300
  },
  "memory": {
    "maxItemChars": 20000,
    "maxTotalChars": 80000
  },
  "attachments": {
    "enabled": true,
    "maxFilesPerMessage": 4,
    "maxFileSize": 10485760,
    "allowedImageTypes": ["image/png", "image/jpeg", "image/webp", "image/gif"]
  },
  "debug": {
    "enabled": false,
    "modelIO": true,
    "rawStreamEvents": true
  },
  "security": {
    "mode": "allow",
    "tools": {
      "bash": {
        "mode": "allow"
      },
      "file_write": {
        "mode": "allow"
      },
      "file_edit": {
        "mode": "allow"
      },
      "memory_save": {
        "mode": "allow"
      },
      "memory_append": {
        "mode": "allow"
      },
      "memory_delete": {
        "mode": "allow"
      }
    },
    "gateway": {
      "host": "127.0.0.1",
      "token": "",
      "sseHeartbeatIntervalMs": 15000
    },
    "auditTools": true
  },
  "searchProvider": "ollama",
  "ollamaApiKey": "YOUR_OLLAMA_API_KEY",
  "searxngUrl": "http://localhost:8080",
  "braveApiKey": "YOUR_BRAVE_API_KEY",
  "subAgent": {
    "allowedTools": ["web_search", "web_fetch", "file_read", "memory_list", "memory_read", "skill_list", "skill_use"],
    "disabledTools": ["bash", "file_write", "file_edit", "memory_save", "memory_append", "memory_delete", "sub_agent_run"],
    "maxIterations": 3,
    "maxConcurrency": 3
  },
  "enabledPlugins": ["feishu"],
  "externalPlugins": [],
  "plugins": {
    "feishu": {
      "appId": "cli_xxx",
      "appSecret": "YOUR_FEISHU_APP_SECRET",
      "verificationToken": "YOUR_FEISHU_VERIFICATION_TOKEN"
    }
  }
}
