{
  "$comment": "完整配置示例。复制到 workspace/config.json 后按需修改；入门推荐使用 config.simple.example.json",
  "remoteModel": { "enabled": true },
  "localModel": {
    "enabled": false,
    "modelId": "qwen3.5-4b-q4",
    "contextSize": 32768
  },
  "apiUrl": "https://ark.cn-beijing.volces.com/api/coding",
  "apiKey": "YOUR_API_KEY",
  "model": "deepseek-v4-flash",
  "modelProvider": "anthropic-messages",
  "maxTokens": 16384,
  "emptyResponseRetries": 1,
  "maxContextTokens": 128000,
  "contextCompressionThreshold": 0.7,
  "bashTerminationGraceMs": 1000,
  "bashMaxOutputChars": 10000,
  "fileReadMaxChars": 20000,
  "maxAgentIterations": 100,
  "sessionSummary": {
    "enabled": true,
    "persistent": true,
    "maxInputChars": 40000,
    "maxOutputTokens": 10000,
    "maxOperations": 32,
    "maxItemChars": 1000,
    "maxSourcesPerOperation": 8,
    "checkpointDeltaThreshold": 20,
    "checkpointMaxChars": 50000,
    "recallMaxResults": 20,
    "recallMaxOutputChars": 20000,
    "recallMaxQueryChars": 500
  },
  "autoMemory": {
    "enabled": true,
    "mode": "hybrid",
    "turnThreshold": 10,
    "maxCandidates": 5,
    "maxBatchChars": 8000,
    "lockTimeoutSeconds": 300
  },
  "profile": {
    "enabled": true,
    "maxItemChars": 2000,
    "maxTotalChars": 8000
  },
  "memory": {
    "enabled": true,
    "maxItemChars": 20000,
    "maxTotalChars": 80000,
    "retrieval": {
      "maxResults": 5,
      "candidateLimit": 20,
      "maxContextChars": 6000,
      "minScore": 0.35
    },
    "embedding": {
      "provider": "local-hash",
      "model": "local-hash-v1",
      "dimensions": 384,
      "apiUrl": "",
      "apiKey": ""
    },
    "maintenance": {
      "inactiveTurns": 200,
      "inactiveDays": 30,
      "trashRetentionDays": 30
    }
  },
  "attachments": {
    "enabled": true,
    "maxFilesPerMessage": 4,
    "maxFileSize": 10485760,
    "allowedImageTypes": ["image/png", "image/jpeg", "image/webp", "image/gif"]
  },
  "debug": {
    "enabled": false,
    "modelIO": false,
    "rawStreamEvents": false
  },
  "security": {
    "trustedProjects": [],
    "background": { "timeoutSeconds": 3600, "maxRunning": 4, "maxLogChars": 20000 },
    "mode": "auto",
    "approvalTtlMs": 86400000,
    "tools": {
      "bash": {
        "mode": "auto"
      },
      "file_write": {
        "mode": "auto"
      },
      "file_edit": {
        "mode": "auto"
      },
      "memory_save": {
        "mode": "allow"
      },
      "memory_append": {
        "mode": "allow"
      },
      "memory_delete": {
        "mode": "allow"
      },
      "memory_restore": {
        "mode": "allow"
      }
    },
    "gateway": {
      "host": "127.0.0.1",
      "token": "",
      "sseHeartbeatIntervalMs": 15000
    },
    "auditTools": true
  },
  "project": {
    "security": {
      "mode": "auto",
      "tools": {
        "file_read": { "mode": "allow" },
        "file_write": { "mode": "auto" },
        "file_edit": { "mode": "auto" },
        "bash": { "mode": "auto" },
        "project_tree": { "mode": "allow" },
        "project_search": { "mode": "allow" },
        "git_status": { "mode": "allow" },
        "git_diff": { "mode": "allow" }
      }
    },
    "maxAgentIterations": 100,
    "gitTimeoutMs": 10000,
    "diffMaxChars": 200000,
    "openTimeoutMs": 30000,
    "treeMaxDepth": 4,
    "treeMaxEntries": 2000,
    "searchMaxResults": 200,
    "searchMaxChars": 50000,
    "searchTimeoutMs": 10000
  },
  "plan": {
    "enabled": true,
    "maxSteps": 8
  },
  "searchProvider": "duckduckgo",
  "ollamaApiKey": "YOUR_OLLAMA_API_KEY",
  "searxngUrl": "http://localhost:8080",
  "braveApiKey": "YOUR_BRAVE_API_KEY",
  "subAgent": {
    "allowedTools": ["web_search", "web_fetch", "file_read", "memory_list", "memory_read", "skill_list", "skill_use"],
    "disabledTools": ["bash", "file_write", "file_edit", "memory_save", "memory_append", "memory_delete", "sub_agent_run"],
    "maxIterations": 3,
    "maxConcurrency": 3
  },
  "enabledPlugins": ["feishu"],
  "externalPlugins": [],
  "pluginStates": {
    "feishu": { "enabled": true }
  },
  "plugins": {
    "core-tool-context": {
      "maxResultTokens": 8000,
      "readMaxTokens": 4000,
      "searchSnippetChars": 1500,
      "safetyMargin": 0.05,
      "summaryRetries": 1,
      "searchMaxResponseBytes": 8388608
    },
    "core-user-input": {
      "enabled": true,
      "maxOptions": 8,
      "maxQuestionChars": 4000,
      "maxAnswerChars": 12000
    },
    "feishu": {
      "appId": "cli_xxx",
      "appSecret": "YOUR_FEISHU_APP_SECRET",
      "verificationToken": "YOUR_FEISHU_VERIFICATION_TOKEN"
    }
  }
}
